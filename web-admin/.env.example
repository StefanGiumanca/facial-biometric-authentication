# Switch this between "wifi" and "ngrok".
VITE_CONNECTION_MODE=wifi

# Phone on the same Wi-Fi/hotspot LAN:
VITE_WIFI_API_BASE_URL=http://172.20.10.13:8000

# Phone using ngrok:
VITE_NGROK_API_BASE_URL=https://your-current-ngrok-url.ngrok-free.dev

# Optional override. If set, this wins over VITE_CONNECTION_MODE.
# VITE_API_BASE_URL=http://127.0.0.1:8000
